{
  "name": "aumento-renta",
  "version": "1.0.0",
  "private": true,
  "description": "How much can your rent go up? Updates a rent between two dates with Mexico's INPC (INEGI) or UDIS, shows the math with the official values, checks Mexico City's cap and writes the message. Offline PWA, no tracking.",
  "keywords": [
    "mexico",
    "renta",
    "rent",
    "inpc",
    "inflacion",
    "udis",
    "inegi",
    "cdmx",
    "arrendamiento",
    "pwa"
  ],
  "homepage": "https://beg-lag.github.io/aumento-renta/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BEG-lag/aumento-renta.git"
  },
  "bugs": {
    "url": "https://github.com/BEG-lag/aumento-renta/issues"
  },
  "license": "MIT",
  "author": "Benjamín Esponda García (https://pivotek.mx)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:dashes": "node scripts/check-dashes.ts",
    "data:update": "node scripts/update-data.ts",
    "data:backfill": "node scripts/update-data.ts --backfill",
    "example": "node scripts/readme-example.ts",
    "readme:sync": "node scripts/readme-example.ts --write",
    "icons": "node scripts/icons.ts",
    "screenshots": "node scripts/screenshots.ts",
    "check": "npm run typecheck && npm run lint && npm run check:dashes && npm run coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
